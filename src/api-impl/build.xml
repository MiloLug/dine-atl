<project name="api-impl" default="dist">
	<!-- the Ant build is intended to be started from Meson. The properties will be set using commandline parameters -->

	<target name="compile">
		<mkdir dir="${build}"/>
		<mkdir dir="${build}.h"/>
		<!-- closure: javac -h rewrites only the headers of classes it compiles, and a header holds the constants its class inherits -->
		<depend srcdir="${srcdir}" destdir="${build}" cache="${build}/.depend" closure="true"/>
		<javac srcdir="${srcdir}" includes="${includes}" destdir="${build}" includeantruntime="false" debug="true">
			<compilerarg line="${javaargs}"/>
			<compilerarg value="-h"/>
			<compilerarg file="${build}.h"/>
		</javac>
		<!-- the ATL builds share ${headers}: a header is written only when its text changed, so one
		     build's Java step leaves the other build's objects newer than their headers -->
		<copy todir="${headers}" overwrite="true">
			<fileset dir="${build}.h">
				<different targetdir="${headers}" ignoreFileTimes="true"/>
			</fileset>
		</copy>
	</target>

	<target name="dist" depends="compile">
		<jar jarfile="${jarfile}" basedir="${build}"/>
	</target>

	<target name="clean">
		<delete dir="${build}"/>
		<delete dir="${dist}"/>
	</target>
</project>