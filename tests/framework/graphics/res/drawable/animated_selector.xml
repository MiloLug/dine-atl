<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:id="@+id/pressed" android:state_pressed="true" android:drawable="@color/pressed"/>
	<item android:id="@+id/idle" android:drawable="@color/idle"/>
	<transition android:fromId="@id/idle" android:toId="@id/pressed" android:drawable="@drawable/frames"/>
</animated-selector>
