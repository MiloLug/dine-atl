<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.dine.pkg.app">
	<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="27"/>
	<application android:label="package app">
		<activity android:name=".Main">
			<meta-data android:name="dine.test.main" android:value="main"/>
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
		<activity android:name=".Viewer">
			<intent-filter>
				<action android:name="android.intent.action.VIEW"/>
				<category android:name="android.intent.category.DEFAULT"/>
				<data android:scheme="dineapp"/>
			</intent-filter>
		</activity>
		<receiver android:name=".Recv">
			<intent-filter>
				<action android:name="dev.dine.pkg.PING"/>
			</intent-filter>
		</receiver>
		<service android:name=".Svc">
			<intent-filter>
				<action android:name="dev.dine.pkg.BIND"/>
			</intent-filter>
			<meta-data android:name="dine.test.svc" android:value="svc"/>
		</service>
		<provider android:name=".Prov" android:authorities="dev.dine.pkg.app.prov">
			<meta-data android:name="dine.test.prov" android:value="prov"/>
			<grant-uri-permission android:pathPrefix="/shared"/>
			<grant-uri-permission android:pathPattern="/files/.*"/>
			<path-permission android:pathPrefix="/private" android:readPermission="dev.dine.pkg.READ"
					android:writePermission="dev.dine.pkg.WRITE"/>
		</provider>
	</application>
</manifest>
