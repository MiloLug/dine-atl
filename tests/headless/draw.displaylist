displaylist: dev.dine.widgets.DrawActivity$DrawView 960x540
displaylist:   rect 10,10 110,60 #ffff0000 fill
displaylist:   line 0,0 100,100 #ff0000ff stroke width 4 cap 0 join 0
displaylist:   line 0,120 50,120 #ff0000ff stroke width 4 cap 0 join 0
displaylist:   line 50,130 100,130 #ff0000ff stroke width 4 cap 0 join 0
displaylist:   rect 0,0 20,10 #ffff0000 fill matrix [0,-2,190;2,0,-10;0,0,1]
displaylist:   rect 120,10 170,60 #ffff0000 fill
displaylist:   clip 180,10 200,30
displaylist:   rect 170,0 210,40 #ff0000ff fill
displaylist:   unclip 1
displaylist:   clip 220,10 240,30 difference
displaylist:   rect 210,0 250,40 #ff0000ff fill
displaylist:   unclip 1
displaylist:   bitmap 64x64 src 0,0 64,64 dst 260,0 324,64 #ff000000
displaylist:   text "Dine bold" 10,190 #ff000000 fill size 30 bold
displaylist:   text "serif italic" 10,230 #ff000000 fill size 30 serif italic
displaylist:   text "mono, centered" 160,270 #ff000000 fill size 30 mono align 1
displaylist:   text "outline" 10,310 #ff0000ff stroke width 1 cap 0 join 0 size 30
displaylist:   text "two lines from a " 0,28 #ff000000 fill size 30 bold matrix [1,0,330;0,1,160;0,0,1]
displaylist:   text "Layout" 0,64 #ff000000 fill size 30 bold matrix [1,0,330;0,1,160;0,0,1]
displaylist: end
